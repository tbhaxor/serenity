From: Antigravity <antigravity@gemini.com>
Date: Tue, 05 May 2026 18:49:00 +0530
Subject: [PATCH] Implement get_num_procs for SerenityOS

---
 driver/others/init.c          | 2 +-
 driver/others/memory.c        | 8 ++++----
 driver/others/memory_qalloc.c | 4 ++--
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/driver/others/init.c b/driver/others/init.c
--- a/driver/others/init.c
+++ b/driver/others/init.c
@@ -1041,7 +1041,7 @@
 
 void gotoblas_affinity_reschedule(void) {};
 
-int get_num_procs(void) { int num = sysconf(_SC_NPROCESSORS_CONF); return (nums >0 ? nums : 2); }
+int get_num_procs(void) { int nums = sysconf(_SC_NPROCESSORS_CONF); return (nums >0 ? nums : 2); }
 
 int get_num_nodes(void) { return 1; }
 
diff --git a/driver/others/memory.c b/driver/others/memory.c
--- a/driver/others/memory.c
+++ b/driver/others/memory.c
@@ -159,7 +159,7 @@
 #include <sys/resource.h>
 #endif
 
-#ifdef OS_HAIKU
+#if defined(OS_HAIKU) || defined(__serenity__)
 #include <unistd.h>
 #endif
 
@@ -320,7 +320,7 @@
 }
 #endif
 
-#ifdef OS_HAIKU
+#if defined(OS_HAIKU) || defined(__serenity__)
 int get_num_procs(void) {
   static int nums = 0;
   if (!nums) nums = sysconf(_SC_NPROCESSORS_CONF);
@@ -450,7 +450,7 @@
 extern int openblas_omp_num_threads_env(void);
 
 int blas_get_cpu_number(void){
-#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU)
+#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU) || defined(__serenity__)
   int max_num;
 #endif
   int blas_goto_num   = 0;
@@ -458,7 +458,7 @@
 
   if (blas_num_threads) return blas_num_threads;
 
-#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU)
+#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU) || defined(__serenity__)
   max_num = get_num_procs();
 #endif
 
@@ -482,7 +482,7 @@
   else if (blas_omp_num > 0) blas_num_threads = blas_omp_num;
   else blas_num_threads = MAX_CPU_NUMBER;
 
-#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU)
+#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU) || defined(__serenity__)
   if (blas_num_threads > max_num) blas_num_threads = max_num;
 #endif
 
@@ -1899,7 +1899,7 @@
 }
 #endif
 
-#ifdef OS_HAIKU
+#if defined(OS_HAIKU) || defined(__serenity__)
 int get_num_procs(void) {
   static int nums = 0;
   if (!nums) nums = sysconf(_SC_NPROCESSORS_CONF);
@@ -2025,7 +2025,7 @@
 extern int openblas_omp_num_threads_env(void);
 
 int blas_get_cpu_number(void){
-#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU)
+#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU) || defined(__serenity__)
   int max_num;
 #endif
   int blas_goto_num   = 0;
@@ -2033,7 +2033,7 @@
 
   if (blas_num_threads) return blas_num_threads;
 
-#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU)
+#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU) || defined(__serenity__)
   max_num = get_num_procs();
 #endif
 
@@ -2057,7 +2057,7 @@
   else if (blas_omp_num > 0) blas_num_threads = blas_omp_num;
   else blas_num_threads = MAX_CPU_NUMBER;
 
-#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU)
+#if defined(OS_LINUX) || defined(OS_WINDOWS) || defined(OS_FREEBSD) || defined(OS_OPENBSD) || defined(OS_NETBSD) || defined(OS_DRAGONFLY) || defined(OS_DARWIN) || defined(OS_ANDROID) || defined(OS_HAIKU) || defined(__serenity__)
   if (blas_num_threads > max_num) blas_num_threads = max_num;
 #endif
 
